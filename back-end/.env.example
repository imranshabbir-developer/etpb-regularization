#==============================================================================
# Regularization of Possession — Evacuee Trust Property Board
#
# Copy this file to .env, then run:
#
#   php artisan key:generate
#   php artisan migrate --seed
#
# .env itself is never committed: it carries the database password and the
# application key.
#==============================================================================

APP_NAME=ETPB-Regularization
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------------------------
# Database
#
# The test suite uses a second database, etpb_regularization_test, which is
# named in phpunit.xml and is created and dropped by the tests themselves.
#------------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=etpb_regularization
DB_USERNAME=root
DB_PASSWORD=

#------------------------------------------------------------------------------
# Session, cache, queue
#
# Sessions are encrypted: they carry the identity of officers who sign statutory
# orders.
#------------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@etpb.gov.pk"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#==============================================================================
# Scheme constants
#
# These are the figures the Scheme for the Management and Disposal of Urban
# Evacuee Trust Properties, 1977 prescribes. They seed the `settings` table on
# first migration; after that the table is the authority, because every value is
# dated and stamped onto the assessments made under it, so that a later change
# cannot silently rewrite a decision already taken.
#
# Change them here only for a fresh installation. On a running system, change
# them through Administration → Settings, which records who changed what and
# from when it applies.
#==============================================================================

# Clause 3(ii)(a) — possession must pre-date 1 January 2010.
ETPB_POSSESSION_CUTOFF=2009-12-31

# Clause 3(ii)(b) — arrears run from the earliest of this date, the date of
# occupation, or the date of a judicial verdict.
ETPB_ARREARS_BASE_DATE=2000-07-01

# The rent year from which assessments are anchored.
ETPB_ASSESSMENT_BASE_DATE=2006-07-01

# Clause 11(ii) — annual enhancement. METHOD is COMPOUND or SIMPLE, and is
# stamped onto every schedule generated; a written ETPB ruling is still
# outstanding on which of the two the Board intends.
ETPB_ENHANCEMENT_RATE=8.00
ETPB_ENHANCEMENT_METHOD=COMPOUND

# Clause 11(i) — re-assessment cycle, in years.
ETPB_REASSESSMENT_YEARS=6

# Clause 10(i)(c) — days allowed to file an objection after service of notice.
ETPB_OBJECTION_WINDOW_DAYS=15

# Clause 10(i)(e) — days allowed to assess the rent after the first notice.
ETPB_ASSESSMENT_SLA_DAYS=60

# Clause 3(ii)(d) — the Administrator decides within one month, with reasons.
ETPB_ADMIN_APPROVAL_SLA_DAYS=30

# The deposit that must be confirmed before an application is processed at all.
ETPB_PROCESSING_FEE=5000.00

# Clause 13 — the maximum number of instalments arrears may be spread over.
ETPB_MAX_INSTALMENTS=24

# Ceiling on the amount a District Officer may deal with without reference up.
ETPB_DO_PENALTY_CEILING=100000.00

# The years shown in the rent schedule summary on screen and in reports.
ETPB_MILESTONE_YEARS=2000,2004,2008,2012,2016,2020,2024

# REVENUE  — 1 Marla = 272.25 sqft, 1 Kanal = 5,445 sqft (Board of Revenue)
# URBAN    — 1 Marla = 225 sqft
# The two differ by 21%, so the profile is selectable per district and frozen
# onto each application together with its conversion trace.
ETPB_DEFAULT_UNIT_PROFILE=REVENUE
